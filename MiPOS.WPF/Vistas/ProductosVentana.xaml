<Window x:Class="MiPOS.WPF.Vistas.ProductosVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiPOS.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProductosViewModel}"
        Title="Productos y stock"
        Height="640" Width="1100"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="16">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CerrarVentanaCommand}"/>
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Búsqueda y filtros -->
            <RowDefinition Height="*"/>
            <!-- Lista -->
            <RowDefinition Height="Auto"/>
            <!-- Mensajes -->
            <RowDefinition Height="Auto"/>
            <!-- Botones -->
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <CheckBox DockPanel.Dock="Right" Content="Solo stock bajo" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding SoloStockBajo}"/>
            <CheckBox DockPanel.Dock="Right" Content="Mostrar desactivados" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding MostrarDesactivados}"/>
            <TextBlock DockPanel.Dock="Left" Text="Buscar (nombre o código):" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtBusqueda" Padding="6"
                     Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <DataGrid x:Name="GrillaProductos" Grid.Row="1"
                  ItemsSource="{Binding Productos}"
                  SelectedItem="{Binding ProductoSeleccionado}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
            <DataGrid.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding EditarCommand}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn     Header="Código"    Binding="{Binding CodigoBarras}"     Width="150"/>
                <DataGridTextColumn     Header="Producto"  Binding="{Binding Nombre}"           Width="*"/>
                <DataGridTextColumn     Header="Categoría" Binding="{Binding Categoria.Nombre}" Width="140"/>
                <DataGridTextColumn     Header="Precio"    Binding="{Binding Precio, StringFormat='$ {0:N2}'}" Width="130"/>
                <DataGridTextColumn     Header="Stock"     Binding="{Binding Stock}"            Width="80"/>
                <DataGridTextColumn     Header="Mínimo"    Binding="{Binding StockMinimo}"      Width="80"/>
                <DataGridCheckBoxColumn Header="Activo"    Binding="{Binding Activo}"           Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap"
                       Foreground="Firebrick" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding MensajeExito}"
                       Foreground="ForestGreen" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                </Style>
            </StackPanel.Resources>
            <Button Content="Nuevo"                  Command="{Binding NuevoCommand}"/>
            <Button Content="Editar (Enter)"         Command="{Binding EditarCommand}"/>
            <Button Content="Ajustar stock"          Command="{Binding AjustarStockCommand}"/>
            <Button Content="Movimientos"            Command="{Binding VerMovimientosCommand}"/>
            <Button Content="{Binding TextoActivar}" Command="{Binding CambiarActivoCommand}"/>
            <Button Content="Cerrar (Esc)"           Command="{Binding CerrarVentanaCommand}"/>
        </StackPanel>
    </Grid>
</Window>
