<Window x:Class="MiPOS.WPF.Vistas.CajaVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiPOS.WPF.ViewModels"
        xmlns:conv="clr-namespace:MiPOS.WPF.Servicios"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CajaViewModel}"
        Title="MiPOS - Caja"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontSize="16">

    <!-- Atajos de teclado de la caja (funcionan aunque el cursor esté en el campo de código) -->
    <Window.InputBindings>
        <KeyBinding Key="F1"     Command="{Binding BuscarProductoCommand}"/>
        <KeyBinding Key="F3"     Command="{Binding CobrarCommand}"/>
        <KeyBinding Key="F4"     Command="{Binding EliminarCommand}"/>
        <KeyBinding Key="F5"     Command="{Binding CambiarCantidadCommand}"/>
        <KeyBinding Key="F6"     Command="{Binding AplicarDescuentoCommand}"/>
        <KeyBinding Key="F7"     Command="{Binding RegistrarMovimientoCajaCommand}"/>
        <KeyBinding Key="F8"     Command="{Binding ReimprimirUltimoTicketCommand}"/>
        <KeyBinding Key="F9"     Command="{Binding GestionarUsuariosCommand}"/>
        <!-- F10 no se puede poner acá: Windows la usa para el menú. Se maneja en CajaVentana.xaml.cs -->
        <KeyBinding Key="F11"    Command="{Binding AbrirOCerrarCajaCommand}"/>
        <KeyBinding Key="F12"    Command="{Binding CerrarSesionCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelarVentaCommand}"/>
        <!-- Ya no quedan teclas F libres: la administración usa Ctrl + letra -->
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding GestionarProductosCommand}"/>
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding GestionarComprasCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding VerFacturasPendientesCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleSiEsTrue"/>
        <conv:VisibleSiFalse x:Key="VisibleSiFalse"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado -->
            <RowDefinition Height="Auto"/>
            <!-- Campo de codigo -->
            <RowDefinition Height="Auto"/>
            <!-- Mensaje -->
            <RowDefinition Height="*"/>
            <!-- Carrito -->
            <RowDefinition Height="Auto"/>
            <!-- Botones -->
            <RowDefinition Height="Auto"/>
            <!-- Total -->
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MiPOS" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="{Binding AvisoStock}" Foreground="DarkOrange" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="24,0,0,0"/>
                <TextBlock Text="{Binding AvisoFacturas}" Foreground="Firebrick" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="24,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding CajaTexto}"/>
                <TextBlock Text="  ·  " Foreground="Gray"/>
                <TextBlock Text="{Binding UsuarioTexto}" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- Campo para escanear o tipear el código -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Código / Producto" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtCodigo"
                     FontSize="22" Padding="8"
                     Text="{Binding CodigoIngresado, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AgregarPorCodigoCommand}"/>
                    <!-- Las flechas mueven la selección del carrito sin sacar el cursor de acá -->
                    <KeyBinding Key="Up"    Command="{Binding SeleccionarAnteriorCommand}"/>
                    <KeyBinding Key="Down"  Command="{Binding SeleccionarSiguienteCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </StackPanel>

        <!-- Mensajes: en rojo los errores, en verde las confirmaciones (venta registrada) -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <!-- Aviso grande mientras la caja está cerrada -->
            <Border Background="Firebrick" Padding="8" Margin="0,0,0,8"
                    Visibility="{Binding CajaAbierta, Converter={StaticResource VisibleSiFalse}}">
                <TextBlock Text="CAJA CERRADA · Presione F11 para abrirla"
                           Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding Mensaje}"
                       Foreground="Firebrick" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding MensajeExito}"
                       Foreground="ForestGreen" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Carrito -->
        <DataGrid x:Name="GrillaCarrito" Grid.Row="3" Margin="0,12"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding ItemSeleccionado}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Focusable="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código"   Binding="{Binding CodigoBarras}" Width="150"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Cant."    Binding="{Binding Cantidad}" Width="80"/>
                <DataGridTextColumn Header="Precio"   Binding="{Binding PrecioUnitario, StringFormat='$ {0:N2}'}" Width="140"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat='$ {0:N2}'}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botones de operación. Focusable="False": al hacer clic, el cursor sigue en el campo de código -->
        <!-- A la izquierda, las de la venta; a la derecha, las de usuario -->
        <DockPanel Grid.Row="4" Margin="0,0,0,12" LastChildFill="False">
            <DockPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                </Style>
            </DockPanel.Resources>
            <Button DockPanel.Dock="Left"  Content="F3  Cobrar"        Command="{Binding CobrarCommand}"/>
            <Button DockPanel.Dock="Left"  Content="F4  Eliminar"      Command="{Binding EliminarCommand}"/>
            <Button DockPanel.Dock="Left"  Content="F5  Cantidad"      Command="{Binding CambiarCantidadCommand}"/>
            <Button DockPanel.Dock="Left"  Content="F6  Descuento"     Command="{Binding AplicarDescuentoCommand}"/>
            <Button DockPanel.Dock="Left"  Content="F7  Retiro/Ingreso" Command="{Binding RegistrarMovimientoCajaCommand}"/>
            <Button DockPanel.Dock="Left"  Content="F8  Reimprimir"    Command="{Binding ReimprimirUltimoTicketCommand}"/>
            <Button DockPanel.Dock="Left"  Content="ESC  Cancelar"     Command="{Binding CancelarVentaCommand}"/>
            <Button DockPanel.Dock="Right" Content="F12  Cerrar sesión" Command="{Binding CerrarSesionCommand}" Margin="0"/>
            <Button DockPanel.Dock="Right" Content="{Binding TextoBotonCaja}" Command="{Binding AbrirOCerrarCajaCommand}"/>
            <Button DockPanel.Dock="Right" Content="F10  Contraseña"   Command="{Binding CambiarMiContrasenaCommand}"/>
            <Button DockPanel.Dock="Right" Content="F9  Usuarios"      Command="{Binding GestionarUsuariosCommand}"/>
            <Button DockPanel.Dock="Right" Content="Ctrl+P  Productos" Command="{Binding GestionarProductosCommand}"/>
            <Button DockPanel.Dock="Right" Content="Ctrl+M  Compras"   Command="{Binding GestionarComprasCommand}"/>
        </DockPanel>

        <!-- Totales -->
        <Grid Grid.Row="5">
            <TextBlock Text="{Binding CantidadArticulos, StringFormat='Artículos: {0}'}"
                       VerticalAlignment="Bottom" Margin="0,0,0,8"/>
            <StackPanel HorizontalAlignment="Right">
                <!-- Subtotal y descuento: solo si hay descuento -->
                <StackPanel Visibility="{Binding TieneDescuento, Converter={StaticResource VisibleSiEsTrue}}">
                    <TextBlock Text="{Binding Subtotal, StringFormat='Subtotal: $ {0:N2}'}"
                               HorizontalAlignment="Right" FontSize="20"/>
                    <TextBlock Text="{Binding TextoDescuento}"
                               HorizontalAlignment="Right" FontSize="20" Foreground="ForestGreen"/>
                </StackPanel>
                <TextBlock Text="{Binding Total, StringFormat='TOTAL: $ {0:N2}'}"
                           HorizontalAlignment="Right"
                           FontSize="36" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>