<Window x:Class="MiPOS.WPF.Vistas.FacturasPendientesVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiPOS.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FacturasPendientesViewModel}"
        Title="Facturas sin autorizar"
        Height="560" Width="1100"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="16">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CerrarVentanaCommand}"/>
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="GrillaFacturas" Grid.Row="0"
                  ItemsSource="{Binding Facturas}"
                  SelectedItem="{Binding FacturaSeleccionada}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Venta N°" Binding="{Binding VentaId}" Width="90"/>
                <DataGridTextColumn Header="Fecha"    Binding="{Binding FechaCreacion, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                <DataGridTextColumn Header="Tipo"     Binding="{Binding Tipo}" Width="100"/>
                <DataGridTextColumn Header="P.V."     Binding="{Binding PuntoVenta}" Width="60"/>
                <DataGridTextColumn Header="Total"    Binding="{Binding Total, StringFormat='$ {0:N2}'}" Width="120"/>
                <DataGridTextColumn Header="Estado"   Binding="{Binding Estado}" Width="100"/>
                <DataGridTextColumn Header="Intentos" Binding="{Binding Intentos}" Width="80"/>
                <DataGridTextColumn Header="Último mensaje" Binding="{Binding Mensaje}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap"
                       Foreground="Firebrick" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding MensajeExito}" TextWrapping="Wrap"
                       Foreground="ForestGreen" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                </Style>
            </StackPanel.Resources>
            <Button Content="Reintentar pendientes" Command="{Binding ReintentarCommand}"/>
            <Button Content="Reimprimir ticket"     Command="{Binding ReimprimirCommand}"/>
            <Button Content="Volver a pendiente"    Command="{Binding VolverAPendienteCommand}"/>
            <Button Content="Cerrar (Esc)"          Command="{Binding CerrarVentanaCommand}"/>
        </StackPanel>
    </Grid>
</Window>
