<Window x:Class="MiPOS.WPF.Vistas.AutorizacionVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiPOS.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AutorizacionViewModel}"
        Title="Autorización requerida"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontSize="16">

    <Window.InputBindings>
        <KeyBinding Key="Enter"  Command="{Binding AutorizarCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}"/>
    </Window.InputBindings>

    <StackPanel Margin="16">
        <TextBlock Text="Se requiere autorización de un administrador" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Motivo}" TextWrapping="Wrap" Margin="0,4,0,12"/>

        <TextBlock Text="Usuario" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtUsuario" Padding="6"
                 Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Contraseña" Margin="0,12,0,4"/>
        <PasswordBox x:Name="PwdContrasena" Padding="6"/>

        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap"
                   Foreground="Firebrick" FontWeight="SemiBold" Margin="0,12,0,0"/>

        <TextBlock Text="Enter: autorizar     Esc: cancelar"
                   Foreground="Gray" FontSize="13" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
