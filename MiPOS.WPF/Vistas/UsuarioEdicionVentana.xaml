<Window x:Class="MiPOS.WPF.Vistas.UsuarioEdicionVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiPOS.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UsuarioEdicionViewModel}"
        Title="{Binding Titulo}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontSize="16">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleSiEsTrue"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Enter"  Command="{Binding GuardarCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}"/>
    </Window.InputBindings>

    <StackPanel Margin="16">
        <TextBlock Text="Usuario (para iniciar sesión)" Margin="0,0,0,4"/>
        <!-- Solo se puede escribir al crear: después no se cambia -->
        <TextBox x:Name="TxtUsuario" Padding="6"
                 IsEnabled="{Binding EsNuevo}"
                 Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Nombre completo" Margin="0,12,0,4"/>
        <TextBox x:Name="TxtNombreCompleto" Padding="6"
                 Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Rol" Margin="0,12,0,4"/>
        <ComboBox ItemsSource="{Binding Roles}"
                  SelectedItem="{Binding RolSeleccionado}"
                  Padding="6"/>

        <TextBlock Text="Idioma" Margin="0,12,0,4"/>
        <ComboBox ItemsSource="{Binding Idiomas}"
                  DisplayMemberPath="Nombre" SelectedValuePath="Codigo"
                  SelectedValue="{Binding IdiomaSeleccionado}"
                  Padding="6"/>

        <!-- Solo al crear: para cambiarla después se usa "Restablecer contraseña" -->
        <StackPanel Visibility="{Binding EsNuevo, Converter={StaticResource VisibleSiEsTrue}}">
            <TextBlock Text="Contraseña" Margin="0,12,0,4"/>
            <PasswordBox x:Name="PwdContrasena" Padding="6"/>

            <TextBlock Text="Repetir contraseña" Margin="0,12,0,4"/>
            <PasswordBox x:Name="PwdConfirmar" Padding="6"/>
        </StackPanel>

        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap"
                   Foreground="Firebrick" FontWeight="SemiBold" Margin="0,12,0,0"/>

        <TextBlock Text="Enter: guardar     Esc: cancelar"
                   Foreground="Gray" FontSize="13" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
