<Window x:Class="MiPOS.WPF.Vistas.LicenciaVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiPOS.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LicenciaViewModel}"
        Title="Licencia de MiPOS"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontSize="16">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CerrarVentanaCommand}"/>
    </Window.InputBindings>

    <StackPanel Margin="16">
        <StackPanel.Resources>
            <Style TargetType="Button">
                <Setter Property="Padding" Value="16,6"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </StackPanel.Resources>

        <TextBlock Text="Licencia de esta PC" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="{Binding Estado}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding AvisoVencimiento}" TextWrapping="Wrap" Foreground="DarkOrange" FontWeight="SemiBold"/>

        <TextBlock Text="Código de instalación (envíeselo a su proveedor para recibir la licencia):"
                   TextWrapping="Wrap" Margin="0,16,0,4" Foreground="Gray"/>
        <TextBox x:Name="TxtCodigo" Text="{Binding CodigoInstalacion, Mode=OneWay}" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="26" Padding="8" HorizontalContentAlignment="Center"/>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Copiar código" Command="{Binding CopiarCodigoCommand}"/>
            <Button Content="Instalar archivo de licencia..." Command="{Binding InstalarCommand}"/>
        </StackPanel>

        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap"
                   Foreground="Firebrick" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <TextBlock Text="{Binding MensajeExito}" TextWrapping="Wrap"
                   Foreground="ForestGreen" FontWeight="SemiBold"/>

        <Button Content="{Binding TextoBotonCerrar}" Command="{Binding CerrarVentanaCommand}"
                HorizontalAlignment="Left" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
