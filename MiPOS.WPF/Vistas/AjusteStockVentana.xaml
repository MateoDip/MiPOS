<Window x:Class="MiPOS.WPF.Vistas.AjusteStockVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiPOS.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AjusteStockViewModel}"
        Title="Ajustar stock"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontSize="16">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}"/>
    </Window.InputBindings>

    <StackPanel Margin="16">
        <TextBlock Text="{Binding NombreProducto}" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding StockActual, StringFormat='Stock actual: {0}'}" Margin="0,4,0,0"/>

        <TextBlock Text="Tipo de ajuste" Margin="0,12,0,4"/>
        <ListBox ItemsSource="{Binding Tipos}"
                 SelectedItem="{Binding TipoSeleccionado}"
                 DisplayMemberPath="Nombre"
                 Focusable="False">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Padding" Value="6,4"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <TextBlock Text="{Binding EtiquetaCantidad}" Margin="0,12,0,4"/>
        <TextBox x:Name="TxtCantidad"
                 FontSize="22" Padding="8"
                 Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
                <KeyBinding Key="Up"    Command="{Binding SubirCommand}"/>
                <KeyBinding Key="Down"  Command="{Binding BajarCommand}"/>
                <KeyBinding Key="Enter" Command="{Binding ConfirmarCommand}"/>
            </TextBox.InputBindings>
        </TextBox>

        <TextBlock Text="Motivo" Margin="0,12,0,4"/>
        <TextBox Padding="8"
                 MaxLength="{Binding LargoMaximoMotivo}"
                 Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ConfirmarCommand}"/>
            </TextBox.InputBindings>
        </TextBox>

        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap"
                   Foreground="Firebrick" FontWeight="SemiBold" Margin="0,12,0,0"/>

        <TextBlock Text="↑ ↓: tipo     Tab: siguiente campo     Enter: guardar     Esc: cancelar"
                   TextWrapping="Wrap" Foreground="Gray" FontSize="13" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
