<Window x:Class="MiPOS.WPF.Vistas.ProveedoresVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiPOS.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProveedoresViewModel}"
        Title="Proveedores"
        Height="520" Width="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="16">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CerrarVentanaCommand}"/>
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Lista -->
            <RowDefinition Height="Auto"/>
            <!-- Mensajes -->
            <RowDefinition Height="Auto"/>
            <!-- Botones -->
        </Grid.RowDefinitions>

        <DataGrid x:Name="GrillaProveedores" Grid.Row="0"
                  ItemsSource="{Binding Proveedores}"
                  SelectedItem="{Binding ProveedorSeleccionado}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
            <DataGrid.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding EditarCommand}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn     Header="Nombre"   Binding="{Binding Nombre}"   Width="*"/>
                <DataGridTextColumn     Header="CUIT"     Binding="{Binding Cuit}"     Width="140"/>
                <DataGridTextColumn     Header="Teléfono" Binding="{Binding Telefono}" Width="180"/>
                <DataGridCheckBoxColumn Header="Activo"   Binding="{Binding Activo}"   Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap"
                       Foreground="Firebrick" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding MensajeExito}"
                       Foreground="ForestGreen" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                </Style>
            </StackPanel.Resources>
            <Button Content="Nuevo"                  Command="{Binding NuevoCommand}"/>
            <Button Content="Editar (Enter)"         Command="{Binding EditarCommand}"/>
            <Button Content="{Binding TextoActivar}" Command="{Binding CambiarActivoCommand}"/>
            <Button Content="Cerrar (Esc)"           Command="{Binding CerrarVentanaCommand}"/>
        </StackPanel>
    </Grid>
</Window>
