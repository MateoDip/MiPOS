<Window x:Class="MiPOS.WPF.Vistas.ClienteFacturaVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiPOS.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ClienteFacturaViewModel}"
        Title="Cliente de la factura"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontSize="16">

    <Window.InputBindings>
        <KeyBinding Key="Enter"  Command="{Binding AceptarCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}"/>
    </Window.InputBindings>

    <StackPanel Margin="16">
        <TextBlock Text="CUIT o DNI (vacío = consumidor final sin identificar)" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtDocumento" Padding="6" MaxLength="13"
                 Text="{Binding Documento, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Nombre o razón social (opcional)" Margin="0,12,0,4"/>
        <TextBox Padding="6" MaxLength="150"
                 Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Condición frente al IVA" Margin="0,12,0,4"/>
        <ComboBox Padding="6"
                  ItemsSource="{Binding Condiciones}"
                  SelectedItem="{Binding CondicionSeleccionada}"
                  DisplayMemberPath="Nombre"/>

        <TextBlock Text="{Binding TextoComprobante}" FontWeight="SemiBold" Margin="0,12,0,0"/>

        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap"
                   Foreground="Firebrick" FontWeight="SemiBold" Margin="0,12,0,0"/>

        <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Consumidor final" Padding="12,4"
                    Command="{Binding ConsumidorFinalCommand}"/>
            <TextBlock Text="Enter: aceptar     Esc: cancelar" VerticalAlignment="Center"
                       Foreground="Gray" FontSize="13"/>
        </DockPanel>
    </StackPanel>
</Window>
