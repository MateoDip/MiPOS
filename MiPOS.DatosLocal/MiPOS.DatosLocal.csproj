<Project Sdk="Microsoft.NET.Sdk">

  <!-- Base local SQLite de cada caja, para seguir vendiendo sin conexión con la base central (Fase 8).
       Está separada de MiPOS.Datos para que "dotnet ef migrations" siga encontrando un único DbContext. -->
  <ItemGroup>
    <ProjectReference Include="..\MiPOS.Dominio\MiPOS.Dominio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
